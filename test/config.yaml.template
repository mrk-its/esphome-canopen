external_components:
  - source: ../components

esp32:
  framework: ${framework}
  board: ${board}

ota:
  - platform: canopen

logger:
  level: VERBOSE

esphome:
  name: "test-node"

canbus:
  platform: esp32_can
  id: can_bus
  can_id: 1
  bit_rate: 125kbps
  tx_queue_len: 128
  rx_queue_len: 128
  rx_pin: GPIO5
  tx_pin: GPIO4

canopen:
  node_id: 1
  entities:
    - index: 1
      id: light1
      tpdo: 0
    - index: 2
      id: sensor1
      size: 4
    - index: 3
      id: binary_sensor1
    - index: 4
      id: cover1
    - index: 5
      id: number1
      size: 1
      min_value: 0
      max_value: 100
    - index: 6
      id: switch1
    - index: 7
      id: alarm1

output:
  - platform: template
    id: output1
    type: float
    write_action:
      - lambda: ''

light:
  - platform: monochromatic
    id: light1
    name: "Test Light 1"
    output: output1
    gamma_correct: 1
    default_transition_length: 0s

sensor:
  - platform: template
    id: sensor1
    name: "Test Sensor 1"
    device_class: temperature
    unit_of_measurement: "°C"
    lambda: 'return 21.5;'

binary_sensor:
  - platform: template
    id: binary_sensor1
    name: "Test Binary Sensor 1"
    device_class: door

cover:
  - platform: template
    id: cover1
    name: "Test Cover 1"
    device_class: shutter
    optimistic: true

number:
  - platform: template
    id: number1
    name: "Test Number 1"
    min_value: 0
    max_value: 100
    step: 1
    optimistic: true

switch:
  - platform: template
    id: switch1
    name: "Test Switch 1"
    optimistic: true

alarm_control_panel:
  - platform: template
    id: alarm1
    name: "Test Alarm 1"
    codes: ["1234"]
