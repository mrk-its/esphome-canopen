external_components:
  - source: ../components

esp32:
  framework: ${framework}
  board: ${board}

ota:
  - platform: canopen

logger:
  level: VERBOSE

esphome:
  name: "test-node"

canbus:
  platform: esp32_can
  id: can_bus
  can_id: 1
  bit_rate: 125kbps
  tx_queue_len: 128
  rx_queue_len: 128
  rx_pin: GPIO5
  tx_pin: GPIO4

canopen:
  node_id: 1
  remote_logs:
    level: INFO
    timeout: 60s
  remote_nodes:
    dimmer: remote_node.yaml
  entities:
    - index: 1
      id: light1
      tpdo: 0
    - index: 2
      id: sensor1
      size: 4
    - index: 3
      id: binary_sensor1
    - index: 4
      id: cover1
    - index: 5
      id: number1
      size: 1
      min_value: 0
      max_value: 100
    - index: 6
      id: switch1
    - index: 7
      id: alarm1
    # one light of each built-in platform, see components/canopen/layout.py
    - index: 8
      id: light_binary
      tpdo: 1
    - index: 9
      id: light_cwww
      tpdo: 1
    - index: 10
      id: light_ct
      tpdo: 1
    - index: 11
      id: light_rgb
      tpdo: 2
    - index: 12
      id: light_rgbw
      tpdo: 2
    - index: 13
      id: light_rgbww
      tpdo: 2
    - index: 14
      id: light_rgbct
      tpdo: 3
    - index: 15
      id: cover_position_tilt
      tpdo: 3
    # mirrors of remote_node.yaml states, offsets computed from its TPDO layout
    - index: 16
      id: hall_state
      rpdo: {node: dimmer, entity: light_hall}
    - index: 18
      id: table_brightness
      size: 1
      min_value: 0
      max_value: 1
      rpdo: {node: dimmer, entity: light_table, state: brightness}
    - index: 19
      id: dimmer_temperature
      rpdo: {node: dimmer, entity: temperature}
    - index: 20
      id: mudroom_state
      rpdo: {node: dimmer, index: 3}
    # `platform: canopen` entity exposed for debugging (state from a remote state slot)
    - index: 21
      id: remote_cover_position

output:
  - platform: template
    id: output1
    type: float
    write_action:
      - lambda: ''
  - platform: template
    id: output2
    type: float
    write_action:
      - lambda: ''
  - platform: template
    id: output3
    type: float
    write_action:
      - lambda: ''
  - platform: template
    id: output4
    type: float
    write_action:
      - lambda: ''
  - platform: template
    id: output5
    type: float
    write_action:
      - lambda: ''
  - platform: template
    id: output_binary
    type: binary
    write_action:
      - lambda: ''

light:
  - platform: monochromatic
    id: light1
    name: "Test Light 1"
    output: output1
    gamma_correct: 1
    default_transition_length: 0s

  - platform: binary
    id: light_binary
    name: "Test Light Binary"
    output: output_binary

  - platform: cwww
    id: light_cwww
    name: "Test Light CWWW"
    cold_white: output1
    warm_white: output2
    cold_white_color_temperature: 6000 K
    warm_white_color_temperature: 2000 K

  - platform: color_temperature
    id: light_ct
    name: "Test Light CT"
    color_temperature: output1
    brightness: output2
    cold_white_color_temperature: 6000 K
    warm_white_color_temperature: 2000 K

  - platform: rgb
    id: light_rgb
    name: "Test Light RGB"
    red: output1
    green: output2
    blue: output3

  - platform: rgbw
    id: light_rgbw
    name: "Test Light RGBW"
    red: output1
    green: output2
    blue: output3
    white: output4

  - platform: rgbww
    id: light_rgbww
    name: "Test Light RGBWW"
    red: output1
    green: output2
    blue: output3
    cold_white: output4
    warm_white: output5
    cold_white_color_temperature: 6000 K
    warm_white_color_temperature: 2000 K
    color_interlock: true

  - platform: rgbct
    id: light_rgbct
    name: "Test Light RGBCT"
    red: output1
    green: output2
    blue: output3
    color_temperature: output4
    white_brightness: output5
    cold_white_color_temperature: 6000 K
    warm_white_color_temperature: 2000 K

sensor:
  - platform: template
    id: sensor1
    name: "Test Sensor 1"
    device_class: temperature
    unit_of_measurement: "°C"
    lambda: 'return 21.5;'
  - platform: template
    id: table_brightness
  - platform: template
    id: dimmer_temperature
  # remote states, from remote state slots
  - platform: canopen
    id: remote_cover_position
    name: "Remote cover position"
    node: dimmer
    entity: cover_hall
    state: position
  - platform: canopen
    id: remote_setpoint
    node: dimmer
    entity: setpoint
  - platform: canopen
    id: remote_hall_color_temp
    node: dimmer
    entity: light_hall
    state: color_temp

text_sensor:
  - platform: canopen
    id: remote_cover_state
    node: dimmer
    entity: cover_hall
  - platform: canopen
    id: remote_alarm_state
    node: dimmer
    entity: alarm_house

binary_sensor:
  - platform: template
    id: binary_sensor1
    name: "Test Binary Sensor 1"
    device_class: door
    on_press:
      - canopen.light.toggle: {node: dimmer, entity: light_table}
      - canopen.light.toggle: {node: dimmer, index: 2}  # same remote state slot
      - canopen.light.turn_on: {node: dimmer, entity: light_table}
      - canopen.light.turn_on: {node: dimmer, entity: light_table, brightness: 50%}
      - canopen.light.turn_on:
          node: dimmer
          entity: light_hall
          brightness: !lambda 'return id(table_brightness).state;'
          color_temperature: 3000 K
      - canopen.light.turn_off: {node: dimmer, entity: light_hall}
      - canopen.switch.turn_on: {node: dimmer, entity: pump}
      - canopen.switch.turn_off: {node: dimmer, entity: relay}
      - canopen.switch.toggle: {node: dimmer, entity: relay}
      - canopen.cover.open: {node: dimmer, entity: cover_hall}
      - canopen.cover.close: {node: dimmer, entity: cover_hall}
      - canopen.cover.stop: {node: dimmer, entity: cover_hall}
      - canopen.cover.toggle: {node: dimmer, entity: cover_hall}
      - canopen.cover.control: {node: dimmer, entity: cover_hall, position: 30%, tilt: 100%}
      - canopen.cover.control: {node: dimmer, entity: cover_hall, stop: true}
      - canopen.alarm_control_panel.disarm: {node: dimmer, entity: alarm_house}
      - canopen.alarm_control_panel.arm_away: {node: dimmer, entity: alarm_house}
      - canopen.alarm_control_panel.arm_home: {node: dimmer, entity: alarm_house}
      - canopen.alarm_control_panel.arm_night: {node: dimmer, entity: alarm_house}
      - canopen.alarm_control_panel.arm_vacation: {node: dimmer, entity: alarm_house}
      - canopen.alarm_control_panel.arm_custom_bypass: {node: dimmer, entity: alarm_house}
      - canopen.number.set: {node: dimmer, entity: setpoint, value: 21.5}
      - canopen.number.set:
          node: dimmer
          entity: setpoint
          value: !lambda 'return id(remote_setpoint).state + 0.5;'
      - canopen.entity_cmd: {node: dimmer, entity: light_table, cmd: 1, value: 127}
      - canopen.entity_cmd:
          node: dimmer
          entity: light_table
          cmd: 1
          value: !lambda 'return id(table_brightness).state < 0.5 ? 254 : 0;'
      - canopen.entity_cmd: {node_id: 0x36, index: 2, value: 1}
  - platform: canopen
    id: remote_relay
    node: dimmer
    entity: relay
  - platform: template
    id: hall_state
  - platform: template
    id: mudroom_state

cover:
  - platform: template
    id: cover1
    name: "Test Cover 1"
    device_class: shutter
    optimistic: true

  - platform: template
    id: cover_position_tilt
    name: "Test Cover Position Tilt"
    optimistic: true
    has_position: true
    tilt_action:
      - lambda: ''

number:
  - platform: template
    id: number1
    name: "Test Number 1"
    min_value: 0
    max_value: 100
    step: 1
    optimistic: true

switch:
  - platform: template
    id: switch1
    name: "Test Switch 1"
    optimistic: true

alarm_control_panel:
  - platform: template
    id: alarm1
    name: "Test Alarm 1"
    codes: ["1234"]
